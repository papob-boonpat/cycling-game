generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Score {
  id        String   @id @default(cuid())
  name      String
  timeMs    Int
  taps      Int
  createdAt DateTime @default(now())

  @@index([timeMs])
}

model GameSetting {
  id        String   @id @default("singleton")
  raceOpen  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

